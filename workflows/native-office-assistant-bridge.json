          },
          "jsonBody": "={\n  \"user_id\": \"{{ $json.body.tenant_id }}\",\n  \"agent_type\": \"office_assistant\",\n  \"action_type\": \"meeting\",\n  \"payload\": {\n    \"title\": \"{{ $json.body.title }}\",\n    \"meeting_date\": \"{{ $json.body.meeting_date }}\",\n    \"duration_minutes\": {{ $json.body.duration_minutes || 0 }},\n    \"participants\": {{ JSON.stringify($json.body.participants || []) }},\n    \"decisions\": {{ JSON.stringify($json.body.decisions || []) }},\n    \"action_items\": {{ JSON.stringify($json.body.action_items || []) }},\n    \"risks\": {{ JSON.stringify($json.body.risks || []) }},\n    \"summary\": \"{{ $json.body.summary }}\"\n  },\n  \"session_id\": \"cerveau\",\n  \"channel\": \"cerveau\"\n}",
