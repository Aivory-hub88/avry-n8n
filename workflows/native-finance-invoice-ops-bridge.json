          }
        },
        "id": "6af523d4-1fd1-4a66-9ced-195478513a44",
        "name": "PG Get Invoice",
        "parameters": {
          "operation": "executeQuery",
          "options": {
            "queryReplacement": "={{ $json.body.invoice_id }},{{ $json.body.tenant_id }}"
          },
          "query": "SELECT i.id, i.customer_name, i.customer_email, i.status, i.currency, i.due_date, i.created_at, i.updated_at, COALESCE((SELECT SUM(quantity*unit_price) FROM aivory_ops.invoice_lines WHERE invoice_id=i.id AND tenant_id=i.tenant_id), 0) as total_amount, COALESCE(json_agg(json_build_object('description',l.description,'quantity',l.quantity,'unit_price',l.unit_price) ORDER BY l.created_at) FILTER (WHERE l.id IS NOT NULL), '[]') as lines FROM aivory_ops.invoices i LEFT JOIN aivory_ops.invoice_lines l ON l.invoice_id=i.id AND l.tenant_id=i.tenant_id WHERE i.id = $1 AND i.tenant_id = $2 GROUP BY i.id",
          "resource": "database"
        },
        "position": [
          780,
          480
        ],
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6
      },
      {
        "alwaysOutputData": true,
        "credentials": {
          "postgres": {
            "id": "JBXrVIufQS1n38mD",
            "name": "Aivory Postgres (native ops)"
          }
        },
        "id": "731553b3-cad3-46ba-bbba-a269acb22706",
        "name": "PG Update Invoice Status",
        "parameters": {
          "operation": "executeQuery",
          "options": {
            "queryReplacement": "={{ $json.body.invoice_id }},{{ $json.body.tenant_id }},{{ $json.body.status }}"
          },
          "query": "UPDATE aivory_ops.invoices SET status=$3, updated_at=now() WHERE id=$1 AND tenant_id=$2 RETURNING id, status",
          "resource": "database"
        },
        "position": [
          780,
