        },
        "query": "SELECT i.id, i.customer_name, i.status, i.currency, i.due_date, i.created_at, COALESCE((SELECT SUM(quantity*unit_price) FROM aivory_ops.invoice_lines WHERE invoice_id=i.id AND tenant_id=i.tenant_id), 0) as total_amount FROM aivory_ops.invoices i WHERE i.tenant_id = $1 AND ($2 = 'all' OR i.status = $2) ORDER BY i.created_at DESC LIMIT 50",
